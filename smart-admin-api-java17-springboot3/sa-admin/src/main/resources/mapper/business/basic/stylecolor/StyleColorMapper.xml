<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.business.basic.stylecolor.dao.StyleColorDao">

    <!-- 分页查询款式颜色 -->
    <select id="queryPage" resultType="net.lab1024.sa.admin.module.business.basic.stylecolor.domain.vo.StyleColorVO">
        SELECT color_id, style_no, color_name, color_code, remark, create_time
        FROM t_style_color
        <where>
            deleted_flag = 0
            <if test="queryForm.styleNo != null and queryForm.styleNo != ''">
                AND INSTR(style_no, #{queryForm.styleNo})
            </if>
            <if test="queryForm.colorName != null and queryForm.colorName != ''">
                AND INSTR(color_name, #{queryForm.colorName})
            </if>
        </where>
        ORDER BY color_id DESC
    </select>

    <!-- 查询全部款式颜色 -->
    <select id="queryAll" resultType="net.lab1024.sa.admin.module.business.basic.stylecolor.domain.vo.StyleColorVO">
        SELECT color_id, style_no, color_name, color_code, remark, create_time
        FROM t_style_color
        WHERE deleted_flag = 0
        ORDER BY color_id DESC
    </select>

</mapper>
